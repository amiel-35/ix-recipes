# Manifeste du harnais : l'interface par laquelle le script d'acceptation de B-a (et tout appelant) lance les outils.
# Une ligne CLE=valeur, sans guillemets autour de la valeur ; `#` pour un commentaire. Quarante clés :
# 12 chemins (relatifs à la racine d'ix-recipes), 14 valeurs, 14 commandes (lancées par `sh -c` dans le dossier du sujet,
# avec R, S et L exportés ; code 0 = accepté, non nul = refusé avec la cause). Voir docs/harnais/architecture-harnais.md §4.

# --- Chemins ---
A3=docs/harnais/A3-format-trace.md
A4=docs/harnais/A4-reglages.yaml
A5=docs/harnais/A5-grille-cadrage.md
A6_ARCHI=docs/harnais/A6-architecture.md
A6_SPEC=docs/harnais/A6-spec.md
A7_GUIDE=docs/harnais/A7-guide-usage.md
A7_TRACE=docs/harnais/A7-lire-une-trace.md
A8=docs/harnais/A8-maintenance.md
SPEC=docs/harnais/spec-harnais.md
ARCHI=docs/harnais/architecture-harnais.md
HOOKS_FICHIER=harnais/hooks.json
MODELE_VERDICT=harnais/modele-verdict.md

# --- Valeurs ---
# La recette de l'amont (skills/<id>.md) et le fichier de trace du sujet (relatif au dossier du sujet).
RECETTE=amont-sujet
TRACE=trace.md
# Les identifiants des étapes de la recette.
ETAPE_EVAL_CADRAGE=evaluation
ETAPE_CADRAGE=fusion
ETAPE_CLOTURE=cloture
ETAPE_VERIF_LIVRABLES=verif_livrables
ETAPE_GOAL=goal
ETAPE_VERIF_GOAL=verif_goal
ETAPE_CRITERES=criteres
ETAPE_CONTRE_VERIF=contre_verif
# Le champ du HANDOFF où une étape qui vérifie rend son verdict, et ses deux valeurs (première ligne du champ).
CHAMP_VERDICT=verdict
VERDICT_OK=OK
VERDICT_REPRENDRE=REPRENDRE
# Le champ du HANDOFF de l'étape des critères qui porte la part cachée.
CHAMP_CACHE=part_cachee

# --- Commandes ---
CMD_LANCER=python3 "$R/harnais/harnais.py" lancer
CMD_TRACE=python3 "$R/harnais/harnais.py" trace
CMD_SUITE=python3 "$R/harnais/harnais.py" suite
CMD_CONTRE_VERIF=python3 "$R/harnais/harnais.py" contre-verif
CMD_GELER=python3 "$R/harnais/harnais.py" geler
CMD_SCEAU=python3 "$R/harnais/harnais.py" sceau
CMD_EMPREINTES=python3 "$R/harnais/harnais.py" empreintes
CMD_TOUR=python3 "$R/harnais/harnais.py" tour
CMD_TOUR_CORRECTION=python3 "$R/harnais/harnais.py" tour-correction
CMD_REGELER=python3 "$R/harnais/harnais.py" regeler
CMD_FIN_PRODUCTION=python3 "$R/harnais/harnais.py" fin-production
CMD_JUGE=python3 "$R/harnais/harnais.py" juge
CMD_OUVRIR=python3 "$R/harnais/harnais.py" ouvrir
CMD_HOOK=python3 "$R/harnais/harnais.py" hook
