{
  "metier": [
    "it_projet"
  ],
  "category": "production",
  "params": {
    "format_spec": {
      "label": "Format de spec",
      "type": "enum",
      "required": false,
      "default": "complet",
      "help": "Profondeur de la spec produite. 'contexte_produit' ajoute utilisateurs, dependances et risques (ancienne valeur 'prd', renommee en 2.0.0).",
      "values": [
        "light",
        "complet",
        "contexte_produit"
      ]
    },
    "mode_spec": {
      "label": "Mode de specification",
      "type": "enum",
      "required": false,
      "default": "auto",
      "help": "Cadre le niveau de la spec : une feature (auto), un ecran, un parcours ou un lot de specs.",
      "values": [
        "auto",
        "ecran",
        "flux",
        "lot"
      ]
    },
    "niveau_decoupage": {
      "label": "Niveau de decoupage",
      "type": "enum",
      "required": false,
      "default": "moyen",
      "help": "Controle le niveau de separation des artifacts compagnons.",
      "values": [
        "faible",
        "moyen",
        "fort"
      ]
    },
    "inclure_mermaid": {
      "label": "Inclure mermaid",
      "type": "boolean",
      "required": false,
      "default": true,
      "help": "Ajouter un schema Mermaid par parcours qui comporte une branche."
    },
    "inclure_user_stories": {
      "label": "Inclure user stories",
      "type": "boolean",
      "required": false,
      "default": true
    },
    "inclure_criteres_acceptation": {
      "label": "Inclure criteres d'acceptation",
      "type": "boolean",
      "required": false,
      "default": true,
      "help": "Format Given/When/Then."
    },
    "inclure_metriques": {
      "label": "Inclure metriques de succes",
      "type": "boolean",
      "required": false,
      "default": true
    },
    "contexte_technique": {
      "label": "Contexte technique",
      "type": "text",
      "required": false,
      "help": "Stack, contraintes d'integration, dependances techniques."
    }
  },
  "ui": {
    "simple_fields": [
      "format_spec",
      "mode_spec",
      "inclure_user_stories",
      "inclure_criteres_acceptation",
      "inclure_metriques"
    ],
    "advanced_fields": [
      "niveau_decoupage",
      "inclure_mermaid",
      "contexte_technique"
    ]
  },
  "execution": {
    "supports_async": true,
    "supports_review_gate": true,
    "max_input_artifacts": 8,
    "max_estimated_tokens": 24000
  },
  "color": "#3B6EA5",
  "kind": "llm",
  "launch_mode": "run",
  "transport": "json",
  "output_format": "markdown",
  "enabled": true,
  "visibility": "public"
}
