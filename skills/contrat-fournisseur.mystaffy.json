{
  "metier": [
    "juridique"
  ],
  "category": "critique",
  "params": {
    "position_lecture": {
      "label": "Position de lecture",
      "type": "enum",
      "required": false,
      "default": "client",
      "help": "Cadre la lecture selon la partie que tu representes : client (acheteur), fournisseur (qui publie ou vend), utilisateur.",
      "values": [
        "client",
        "fournisseur",
        "utilisateur"
      ]
    },
    "type_document": {
      "label": "Type de document",
      "type": "enum",
      "required": false,
      "default": "contrat_negocie",
      "help": "Choisit le jeu de clauses a lire : CGV / CGU d'adhesion, contrat fournisseur ou de prestation negocie, conditions de service SaaS / cloud.",
      "values": [
        "cgv_cgu",
        "contrat_negocie",
        "saas_cloud"
      ]
    },
    "type_fournisseur": {
      "label": "Type de fournisseur",
      "type": "enum",
      "required": false,
      "default": "prestation",
      "help": "Pour un contrat negocie : permet de cadrer les clauses a surveiller en priorite.",
      "values": [
        "prestation",
        "logiciel",
        "maintenance",
        "outsourcing",
        "autre"
      ]
    },
    "niveau_detail": {
      "label": "Niveau de detail",
      "type": "enum",
      "required": false,
      "default": "standard",
      "values": [
        "flash",
        "standard",
        "complet"
      ]
    }
  },
  "ui": {
    "simple_fields": [
      "position_lecture",
      "type_document",
      "niveau_detail"
    ],
    "advanced_fields": [
      "type_fournisseur"
    ]
  },
  "execution": {
    "supports_async": false,
    "supports_review_gate": true,
    "max_input_artifacts": 4,
    "max_estimated_tokens": 16000
  },
  "color": "#8A5A3B",
  "kind": "llm",
  "launch_mode": "run",
  "transport": "json",
  "output_format": "markdown",
  "enabled": true,
  "visibility": "public"
}
